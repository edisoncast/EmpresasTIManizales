---
export interface Props {
  title?: string;
  message?: string;
  ctaHref?: string;
  ctaLabel?: string;
  /** Si es un estado de "sin resultados de filtro", se marca para el script de filtros. */
  forFilters?: boolean;
}
const {
  title = 'Aún no hay registros',
  message = 'Este dato todavía no existe en el archivo. Puedes ser la primera persona en aportarlo con una fuente pública.',
  ctaHref = '/contribuir',
  ctaLabel = 'Sugerir un registro',
  forFilters = false,
} = Astro.props;
---

<!-- Hoja por llenar: borde punteado sobre la hoja, sin ilustraciones. -->
<div
  class="border border-dashed border-rule-strong bg-sheet px-6 py-10"
  data-empty-state={forFilters ? 'filters' : 'data'}
>
  <h2 class="text-xl">{title}</h2>
  <p class="mt-2 max-w-reading text-sm text-graphite-2">{message}</p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    {
      forFilters && (
        <button type="button" class="btn-secondary" data-clear-filters-cta>
          Limpiar filtros
        </button>
      )
    }
    {
      ctaHref && (
        <a href={ctaHref} class:list={[forFilters ? 'btn-quiet' : 'btn-primary']}>
          {ctaLabel}
        </a>
      )
    }
  </div>
</div>
