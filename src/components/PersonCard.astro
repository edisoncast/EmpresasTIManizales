---
import Tag from './Tag.astro';
import VerificationStatus from './VerificationStatus.astro';
import type { Person } from '../lib/data';

export interface Props {
  person: Person;
  attrs?: Record<string, string>;
}
const { person, attrs = {} } = Astro.props;
const initials = person.name
  .split(' ')
  .slice(0, 2)
  .map((n) => n.charAt(0))
  .join('')
  .toUpperCase();
const firstContribution = person.contributions?.[0];
---

<article class="ficha ficha-lazy" {...attrs}>
  <div class="ficha-head">
    <p class="field-label">Persona</p>
    <VerificationStatus
      verificationStatus={person.verificationStatus}
      needsVerification={person.needsVerification}
      lastVerifiedAt={person.lastVerifiedAt}
    />
  </div>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div class="flex items-start gap-3">
      <span
        class="figure grid h-12 w-12 shrink-0 place-items-center bg-sheet-alt text-lg"
        aria-hidden="true"
        >{initials}</span
      >
      <div class="min-w-0">
        <h3 class="text-lg">
          <a href={`/personas/${person.slug}`} class="ficha-title-link">{person.name}</a>
        </h3>
        {person.headline && <p class="mt-0.5 text-sm text-graphite-2">{person.headline}</p>}
      </div>
    </div>

    {firstContribution && <p class="line-clamp-2 text-sm text-graphite">
      <span class="text-graphite-2">Contribución:</span> {firstContribution}
    </p>}

    {person.specialties.length > 0 && <div class="flex flex-wrap gap-1.5">
      {person.specialties.slice(0, 3).map((a) => (
        <Tag label={a} tone="soft" />
      ))}
    </div>}
  </div>

  <div class="flex items-center justify-end border-t border-rule px-4 py-2.5">
    <a href={`/personas/${person.slug}`} class="link text-sm">
      Ver trayectoria <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
