---
import Tag from './Tag.astro';
import VerificationStatus from './VerificationStatus.astro';
import { resolveVerification, type VerificationState } from '../lib/verification';

export interface Field {
  label: string;
  value: string;
  /** Valor tipo código o fecha: se compone en monoespaciada. */
  code?: boolean;
}

export interface Props {
  title: string;
  href: string;
  /** Tipo de entidad (ej. "Empresa", "Universidad"), como etiqueta de casilla. */
  kicker?: string;
  /** Código de registro junto al tipo (ej. "CIIU J6201", "SNIES 11268"). */
  code?: string;
  subtitle?: string;
  description?: string;
  tags?: string[];
  /** Casillas de datos al pie de la ficha (etiqueta + valor); las vacías se omiten. */
  fields?: Field[];
  needsVerification?: boolean;
  verificationStatus?: VerificationState;
  status?: 'active' | 'inactive' | 'unknown';
  lastVerifiedAt?: string;
  cta?: string;
  /** Atributos data-* para el filtrado en cliente. */
  attrs?: Record<string, string>;
}
const {
  title,
  href,
  kicker,
  code,
  subtitle,
  description,
  tags = [],
  fields = [],
  needsVerification = false,
  verificationStatus,
  status,
  lastVerifiedAt,
  cta = 'Ver ficha',
  attrs = {},
} = Astro.props;

const state = resolveVerification({ verificationStatus, needsVerification, status });
const isArchived = state === 'archived' || state === 'inactive_or_unverified';
const shownTags = tags.slice(0, 4);
const restTags = tags.length - shownTags.length;
const shownFields = fields.filter((f) => f.value);
---

<article class:list={['ficha', isArchived && 'ficha-archived']} {...attrs}>
  <div class="ficha-head">
    <p class="flex min-w-0 flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
      {kicker && <span class="field-label">{kicker}</span>}
      {code && <span class="data text-xs text-graphite-2">{code}</span>}
    </p>
    <VerificationStatus
      verificationStatus={verificationStatus}
      needsVerification={needsVerification}
      status={status}
      lastVerifiedAt={lastVerifiedAt}
    />
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="text-lg">
      <a href={href} class="ficha-title-link">{title}</a>
    </h3>
    {subtitle && <p class="text-sm text-graphite-2">{subtitle}</p>}

    {Astro.slots.has('badge') && <div class="flex flex-wrap gap-1.5">
      <slot name="badge" />
    </div>}

    {description && <p class="line-clamp-3 text-sm text-graphite-2">{description}</p>}

    {shownTags.length > 0 && <div class="mt-1 flex flex-wrap items-center gap-1.5">
      {shownTags.map((t) => (
        <Tag label={t} tone="soft" />
      ))}
      {restTags > 0 && <span class="text-xs text-graphite-2">+{restTags} más</span>}
    </div>}
  </div>

  {shownFields.length > 0 && <dl class="fields border-x-0 border-b-0">
    {shownFields.map((f) => <div class="field">
      <dt>{f.label}</dt>
      <dd class:list={[f.code && 'data font-normal']}>{f.value}</dd>
    </div>)}
  </dl>}

  <div class="flex items-center justify-end border-t border-rule px-4 py-2.5">
    <a href={href} class="link text-sm">
      {cta}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
