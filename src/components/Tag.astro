---
export interface Props {
  label: string;
  href?: string;
  tone?: 'soft' | 'neutral' | 'outline';
}
const { label, href, tone = 'neutral' } = Astro.props;

// Etiquetas rectas; los tonos solo cambian el fondo y el borde, nunca el significado.
const tones: Record<string, string> = {
  soft: 'border-rule bg-fog text-graphite',
  neutral: 'border-rule bg-sheet text-graphite',
  outline: 'border-rule-strong bg-transparent text-graphite-2',
};
const cls = `badge font-medium ${tones[tone]}`;
---

{
  href ? (
    <a
      href={href}
      class={`${cls} no-underline transition-colors duration-fast hover:border-highlight hover:bg-highlight hover:text-on-highlight`}
    >
      {label}
    </a>
  ) : (
    <span class={cls}>{label}</span>
  )
}
