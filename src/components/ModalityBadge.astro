---
import { label } from '../lib/format';

/**
 * Badge de modalidad académica (presencial, virtual, a distancia, híbrido).
 * Distingue programas homónimos: el texto siempre está presente (nunca solo
 * color) y cada modalidad cambia la forma del borde para escanear rápido.
 */
export interface Props {
  modality?: string;
}
const { modality } = Astro.props;

const tones: Record<string, string> = {
  onsite: 'border-rule-strong bg-sheet text-graphite',
  remote: 'border-ink-blue bg-sheet text-ink-blue',
  distance: 'border-dashed border-rule-strong bg-sheet text-graphite',
  hybrid: 'border-graphite bg-sheet text-graphite',
  unknown: 'border-dashed border-rule bg-transparent text-graphite-2',
};
const tone = tones[modality ?? 'unknown'] ?? tones.unknown;
---

<span class={`badge ${tone}`}>Modalidad: {label('modality', modality)}</span>
