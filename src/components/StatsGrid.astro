---
export interface Stat {
  label: string;
  value: number;
  href?: string;
  note?: string;
}
export interface Props {
  stats: Stat[];
  /** Nota de corte temporal / aclaración (registros, no indicadores). */
  caption?: string;
}
const { stats, caption } = Astro.props;
---

<div>
  <ul class="grid grid-cols-2 gap-px border border-rule bg-rule sm:grid-cols-3 lg:grid-cols-6">
    {
      stats.map((s) => {
        const inner = (
          <>
            <span class="figure block text-[2.25rem] leading-none sm:text-[2.75rem]">
              <span class="ficha-title-link">{s.value}</span>
            </span>
            <span class="mt-2 block text-sm font-medium text-graphite">{s.label}</span>
            {s.note && <span class="data mt-0.5 block text-xs text-graphite-2">{s.note}</span>}
          </>
        );
        return s.href ? (
          <li class="ficha border-0 bg-sheet">
            <a href={s.href} class="block h-full px-4 pb-4 pt-3 no-underline">
              {inner}
            </a>
          </li>
        ) : (
          <li class="bg-sheet px-4 pb-4 pt-3">{inner}</li>
        );
      })
    }
  </ul>
  {caption && <p class="data mt-3 text-xs text-graphite-2">{caption}</p>}
</div>
