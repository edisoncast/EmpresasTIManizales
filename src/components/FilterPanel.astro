---
export interface FacetOption {
  value: string;
  label: string;
}
export interface Facet {
  key: string;
  label: string;
  /** Texto (valor = etiqueta) u opción con valor corto para la URL, p. ej. `?estado=parcial`. */
  options: (string | FacetOption)[];
  allLabel?: string;
  searchable?: boolean;
}
export interface Props {
  facets: Facet[];
  gridClass?: string;
}
const { facets, gridClass = 'grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4' } = Astro.props;
const asOption = (opt: string | FacetOption): FacetOption =>
  typeof opt === 'string' ? { value: opt, label: opt } : opt;
---

<div class={gridClass}>
  {facets.map((facet) => <div class="min-w-0">
    <label for={`facet-${facet.key}`} class="field-label mb-1 block">
      {facet.label}
    </label>
    {facet.searchable ? (
      <>
        <input
          id={`facet-${facet.key}`}
          type="text"
          class="input"
          list={`facet-${facet.key}-options`}
          placeholder={facet.allLabel ?? 'Todas'}
          aria-describedby={`facet-${facet.key}-hint`}
          data-facet-select
          data-facet-key={facet.key}
        />
        <datalist id={`facet-${facet.key}-options`}>
          {facet.options.map(asOption).map((opt) => <option value={opt.value}>{opt.label}</option>)}
        </datalist>
        <p id={`facet-${facet.key}-hint`} class="mt-1 text-xs text-graphite-2">
          Escribe y elige una categoría completa. Borra el campo para ver todas.
        </p>
      </>
    ) : (
      <select id={`facet-${facet.key}`} class="input" data-facet-select data-facet-key={facet.key}>
        <option value="">{facet.allLabel ?? 'Todas'}</option>
        {facet.options.map(asOption).map((opt) => <option value={opt.value}>{opt.label}</option>)}
      </select>
    )}
  </div>)}
</div>
