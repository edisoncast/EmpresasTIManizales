---
export interface Facet {
  key: string;
  label: string;
  options: string[];
  allLabel?: string;
}
export interface Props {
  facets: Facet[];
}
const { facets } = Astro.props;
---

<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {facets.map((facet) => <div>
    <label for={`facet-${facet.key}`} class="field-label mb-1 block">
      {facet.label}
    </label>
    <select id={`facet-${facet.key}`} class="input" data-facet-select data-facet-key={facet.key}>
      <option value="">{facet.allLabel ?? 'Todas'}</option>
      {facet.options.map((opt) => <option value={opt}>{opt}</option>)}
    </select>
  </div>)}
</div>
