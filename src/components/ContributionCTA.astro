---
import { site } from '../lib/site';

export interface Props {
  variant?: 'add' | 'correct' | 'source' | 'person' | 'general';
  /** Nombre de la entidad, para personalizar el texto en fichas. */
  entityName?: string;
  compact?: boolean;
}
const { variant = 'general', entityName, compact = false } = Astro.props;

const copy = {
  add: {
    title: 'Falta un registro',
    body: 'Si conoces un actor del ecosistema que no aparece, ayúdanos a documentarlo con una fuente pública.',
    primary: { label: 'Sugerir un registro', href: site.issuesUrl },
  },
  correct: {
    title: entityName ? `¿Este registro necesita una corrección?` : 'Sugerir una corrección',
    body: 'Los datos pueden cambiar o quedar incompletos. Propón una corrección con una fuente pública; no necesitas saber Git.',
    primary: { label: 'Sugerir una corrección', href: site.correctionUrl },
  },
  source: {
    title: 'Aportar una fuente',
    body: 'Ayúdanos a subir el nivel de verificación de este registro compartiendo una fuente pública.',
    primary: { label: 'Aportar una fuente', href: site.correctionUrl },
  },
  person: {
    title: '¿Es tu perfil o quieres corregirlo?',
    body: 'Puedes solicitar un ajuste o el retiro de tu información, o corregir un dato con una fuente pública. No publicamos datos sensibles.',
    primary: { label: 'Solicitar ajuste o retiro de información', href: site.removalUrl },
  },
  general: {
    title: 'Este es un archivo vivo',
    body: 'Los datos son abiertos y se mantienen entre comunidad. Sugiere, corrige o reporta con una fuente pública; no necesitas saber Git.',
    primary: { label: 'Cómo contribuir', href: '/contribuir' },
  },
};
const c = copy[variant];
const external = c.primary.href.startsWith('http');
---

<!-- Banda de contribución: la única superficie amarilla a pleno color de la vista. -->
<div class:list={['bg-highlight text-on-highlight', compact ? 'p-4' : 'p-6']}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class:list={['text-on-highlight', compact ? 'text-base' : 'text-xl']}>
        {c.title}
      </h2>
      <p class="mt-1 max-w-[60ch] text-sm">{c.body}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2">
      <a
        href={c.primary.href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        class="btn whitespace-nowrap bg-on-highlight text-highlight hover:border-on-highlight hover:bg-transparent hover:text-on-highlight focus-visible:outline-on-highlight"
      >
        {c.primary.label}
      </a>
    </div>
  </div>
</div>
