---
import { nav, type NavItem } from '../lib/site';

const current = Astro.url.pathname;
const matches = (p: string) => current === p || current.startsWith(p + '/');
const isActive = (item: NavItem) => (item.match ?? [item.href]).some(matches);
---

<header class="sticky top-0 z-40 border-b-2 border-graphite bg-sheet">
  <div class="container-content flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-baseline gap-2.5 no-underline">
      <span
        class="font-display text-lg font-extrabold uppercase leading-none tracking-[0.02em] text-graphite [font-stretch:125%]"
        >Observatorio TIC</span
      >
      <span class="hidden text-sm text-graphite-2 sm:inline">Manizales y Caldas</span>
    </a>

    <nav aria-label="Navegación principal" class="hidden xl:block">
      <ul class="flex items-center gap-0.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item) ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center px-2.5 text-sm font-medium no-underline transition-colors duration-fast hover:bg-highlight hover:text-on-highlight',
                  isActive(item)
                    ? 'text-graphite shadow-[inset_0_-3px_0_var(--color-ink-blue)]'
                    : 'text-graphite-2',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <details class="relative xl:hidden">
        <summary
          class="btn-secondary cursor-pointer list-none"
          aria-label="Abrir menú de navegación"
        >
          Menú
        </summary>
        <nav
          aria-label="Navegación"
          class="absolute right-0 z-50 mt-2 w-60 border border-graphite bg-sheet p-2 shadow-overlay"
        >
          <ul class="flex flex-col">
            {
              [...nav, { href: '/acerca', label: 'Acerca' }].map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item) ? 'page' : undefined}
                    class:list={[
                      'block min-h-11 px-3 py-2.5 text-sm no-underline hover:bg-highlight hover:text-on-highlight',
                      isActive(item)
                        ? 'bg-ink-blue-soft font-semibold text-graphite'
                        : 'text-graphite',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
