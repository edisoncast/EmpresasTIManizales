---
import { site } from '../lib/site';
import { formatDate } from '../lib/format';

export interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  /** Muestra la nota de corte temporal de la auditoría. */
  showCutoff?: boolean;
}
const { title, description, eyebrow, showCutoff = true } = Astro.props;
---

<div class="border-b-2 border-graphite bg-fog">
  <div class="container-content py-10 sm:py-12">
    {eyebrow && <p class="field-label">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-3xl">
      {title}
    </h1>
    {description && <p class="mt-3 max-w-reading text-md text-graphite">{description}</p>}
    {
      showCutoff && (
        <p class="data mt-4 inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-graphite-2">
          <span>Corte de datos: {formatDate(site.auditDate)}</span>
          <span aria-hidden="true">·</span>
          <a href="/acerca" class="link font-normal">
            Metodología
          </a>
        </p>
      )
    }
    <div class="mt-4">
      <slot />
    </div>
  </div>
</div>
