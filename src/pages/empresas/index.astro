---
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Browser from '../../components/Browser.astro';
import CompanySizeOverview from '../../components/CompanySizeOverview.astro';
import EntityCard from '../../components/EntityCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { companies } from '../../lib/data';
import { decadeLabel, label } from '../../lib/format';
import { encodeFacet, uniqueSorted } from '../../lib/search';
import { verificationFacetOptions, verificationSlug } from '../../lib/verification';
import { site } from '../../lib/site';

const regYear = (c: (typeof companies)[number]) =>
  c.registeredAt ? c.registeredAt.slice(0, 4) : '';

const cities = uniqueSorted(companies.map((c) => c.city));
const categories = uniqueSorted(companies.flatMap((c) => c.categories));
const sizes = uniqueSorted(companies.map((c) => label('size', c.size)));
const forms = uniqueSorted(companies.map((c) => c.legalForm ?? '').filter(Boolean));
// Décadas de matrícula (la década en curso se recorta al año máximo con datos, ej. 2020–2026).
const regYears = companies.map(regYear).filter(Boolean).map(Number);
const maxRegYear = regYears.length > 0 ? Math.max(...regYears) : undefined;
const regDecade = (c: (typeof companies)[number]) =>
  regYear(c) ? decadeLabel(Number(regYear(c)), maxRegYear) : '';
const decades = uniqueSorted(companies.map(regDecade));
const sizeOrder = [
  { key: 'micro', label: 'Microempresa' },
  { key: 'small', label: 'Pequeña empresa' },
  { key: 'medium', label: 'Mediana empresa' },
  { key: 'large', label: 'Gran empresa' },
  { key: 'unknown', label: 'Sin dato' },
] as const;
const sizeDistribution = sizeOrder.map((item) => ({
  ...item,
  count: companies.filter((company) => company.size === item.key).length,
}));
const cityDistribution = uniqueSorted(companies.map((c) => c.city ?? '').filter(Boolean))
  .map((city) => ({ city, count: companies.filter((company) => company.city === city).length }))
  .sort((a, b) => b.count - a.count);

const facets = [
  { key: 'city', label: 'Ciudad', options: cities, allLabel: 'Todas las ciudades' },
  {
    key: 'category',
    label: 'Categoría',
    options: categories,
    allLabel: 'Todas las categorías',
    searchable: true,
  },
  { key: 'size', label: 'Tamaño', options: sizes, allLabel: 'Todos los tamaños' },
  { key: 'form', label: 'Forma jurídica', options: forms, allLabel: 'Todas' },
  { key: 'decade', label: 'Década de matrícula', options: decades, allLabel: 'Cualquier década' },
  {
    key: 'estado',
    label: 'Verificación',
    options: verificationFacetOptions(companies),
    allLabel: 'Todos los estados',
  },
];
---

<Layout
  title="Empresas"
  description="Empresas de base tecnológica y casas de desarrollo de software en Manizales y Caldas."
>
  <PageHeader
    eyebrow="Registro · Empresas"
    title="Empresas de base tecnológica"
    description="Empresas y organizaciones tecnológicas con presencia en Manizales y Caldas. Busca por nombre o NIT y filtra el registro. Cada ficha muestra su estado de verificación. No es un ranking."
    compact={true}
  />

  <div class="container-content py-4">
    {companies.length === 0 ? (
      <EmptyState
        title="Aún no hay empresas registradas"
        message="El repositorio original no incluía datos estructurados de empresas. ¡Sé la primera persona en aportar una!"
      />
    ) : (
      <>
        <details class="mb-4 border border-rule bg-sheet-alt">
          <summary class="min-h-11 cursor-pointer px-4 py-3 text-sm font-medium text-ink-blue">
            ¿Cómo leer estos datos y tamaños?
          </summary>
          <div class="border-t border-rule p-4">
            <p class="mb-6 text-sm text-graphite-2">
              <strong>Fuente:</strong>
              <a
                href={site.sources.ccmpc.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >
                Cámara de Comercio de Manizales por Caldas
              </a
              >{' '} y otras fuentes públicas — registros con actividades relacionadas con software,
              servicios TI, infraestructura, conectividad, datos o ciberseguridad en Manizales y
              Caldas. Los datos se revalidan a 2026 y cada ficha indica su nivel de evidencia. Por
              privacidad no publicamos correos, direcciones ni representantes, y omitimos el número
              de identificación de personas naturales. También puedes explorar la{' '}
              <a href="/decadas" class="link"> evolución del ecosistema por décadas </a>
              .
            </p>
            <CompanySizeOverview
              sizes={sizeDistribution}
              cities={cityDistribution}
              total={companies.length}
            />
          </div>
        </details>
        <Browser
          facets={facets}
          total={companies.length}
          noun="empresas"
          searchLabel="Buscar por nombre o NIT"
          searchPlaceholder="Nombre, NIT, tecnología o categoría…"
          filterGridClass="grid grid-cols-1 gap-3 lg:grid-cols-3"
          emptyTitle="No encontramos empresas que coincidan con estos filtros."
          emptyCtaLabel="¿Conoces alguna empresa con este perfil? Añádela al directorio"
          emptyCtaPrimary={true}
        >
          {companies.map((c) => (
            <EntityCard
              title={c.name}
              href={`/empresas/${c.slug}`}
              kicker={c.legalForm ?? 'Empresa'}
              code={c.ciiu ? `CIIU ${c.ciiu}` : undefined}
              subtitle={c.nit ? `NIT ${c.nit}` : undefined}
              description={c.description}
              tags={c.categories}
              fields={[
                { label: 'Ciudad', value: c.city },
                { label: 'Tamaño', value: label('size', c.size) },
                { label: 'Matrícula', value: String(regYear(c) ?? ''), code: true },
              ]}
              needsVerification={c.needsVerification}
              verificationStatus={c.verificationStatus}
              lastVerifiedAt={c.lastVerifiedAt}
              cta="Ver ficha"
              stretchedLink={true}
              attrs={{
                'data-item': '',
                'data-search': [
                  c.name,
                  c.description ?? '',
                  c.city,
                  c.nit ?? '',
                  c.legalForm ?? '',
                  ...c.categories,
                ].join(' '),
                'data-facet-city': encodeFacet([c.city]),
                'data-facet-category': encodeFacet(c.categories),
                'data-facet-size': encodeFacet([label('size', c.size)]),
                'data-facet-form': encodeFacet(c.legalForm ? [c.legalForm] : []),
                'data-facet-decade': encodeFacet(regDecade(c) ? [regDecade(c)] : []),
                'data-facet-estado': encodeFacet([verificationSlug(c)]),
              }}
            />
          ))}
        </Browser>
      </>
    )}
  </div>
</Layout>
