---
import Layout from '../components/Layout.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import ContributionCTA from '../components/ContributionCTA.astro';
import Coordinates from '../components/Coordinates.astro';
import PersonCard from '../components/PersonCard.astro';
import { stats, companies, universities, programs, people, communities } from '../lib/data';
import { site } from '../lib/site';
import { formatDate } from '../lib/format';
import { resolveVerification, verificationMeta, verificationOrder } from '../lib/verification';

const cutoff = formatDate(site.auditDate);
const activeCommunities = communities.filter((community) => community.status === 'active');

// Orientación por necesidad para quien llega por primera vez.
const starts = [
  {
    title: 'Quiero estudiar',
    text: 'Universidades y programas TIC de la región: técnico, tecnológico, pregrado y posgrado.',
    href: '/formacion',
    cta: 'Ver formación',
  },
  {
    title: 'Quiero conocer empresas',
    text: 'Empresas de base tecnológica y casas de desarrollo de software registradas en Caldas.',
    href: '/empresas',
    cta: 'Ver empresas',
  },
  {
    title: 'Quiero participar en comunidad',
    text: 'Comunidades, meetups y la agenda de encuentros técnicos de la región.',
    href: '/comunidades',
    cta: 'Ver comunidad',
  },
  {
    title: 'Quiero entender el territorio',
    text: 'Cómo se conectan universidades, empresas, personas y comunidades en el mapa.',
    href: '/ecosistema',
    cta: 'Ver el mapa',
  },
];

// Tipos de registro del archivo: una sola tarjeta por tipo con su conteo.
const archive = [
  {
    href: '/empresas',
    title: 'Empresas',
    count: stats.companies,
    text: 'Empresas de base tecnológica y casas de desarrollo de software.',
  },
  {
    href: '/universidades',
    title: 'Universidades',
    count: stats.universities,
    text: 'Instituciones con formación en software, datos, redes y afines.',
  },
  {
    href: '/programas',
    title: 'Programas',
    count: stats.programs,
    text: 'Técnicos, tecnológicos, pregrados y posgrados del área TIC.',
  },
  {
    href: '/personas',
    title: 'Personas',
    count: stats.people,
    text: 'Trayectorias públicas que construyen ecosistema.',
  },
  {
    href: '/comunidades',
    title: 'Comunidades activas',
    count: activeCommunities.length,
    text: 'Meetups activos y archivo histórico de comunidades técnicas de la región.',
  },
  {
    href: '/eventos',
    title: 'Agenda',
    count: stats.events,
    text: 'Encuentros próximos, pasados y por verificar, dentro de Comunidad.',
  },
];

// Estados de verificación en todo el archivo, con el desglose por tipo enlazado al listado
// ya filtrado por ese estado (?estado=<slug>) para invitar a completar fuentes.
const collections = [
  { label: 'Empresas', href: '/empresas', items: companies },
  { label: 'Universidades', href: '/universidades', items: universities },
  { label: 'Programas', href: '/programas', items: programs },
  { label: 'Personas', href: '/personas', items: people },
  { label: 'Comunidades', href: '/comunidades', items: communities },
];
const distTotal = collections.reduce((sum, c) => sum + c.items.length, 0);
const byState = verificationOrder.map((state) => {
  const parts = collections
    .map((c) => ({
      label: c.label,
      href: `${c.href}?estado=${verificationMeta[state].slug}`,
      count: c.items.filter((e) => resolveVerification(e) === state).length,
    }))
    .filter((part) => part.count > 0);
  return { state, total: parts.reduce((sum, part) => sum + part.count, 0), parts };
});

const featuredPeople = people.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site ?? Astro.url).toString(),
};
---

<Layout jsonLd={jsonLd}>
  <!-- Hero: la intención principal es buscar; el resto se ordena alrededor. -->
  <section class="border-b-2 border-graphite bg-fog">
    <div class="container-content py-12 sm:py-14 lg:py-16">
      <p class="field-label flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>Observatorio abierto</span>
        <span aria-hidden="true">·</span>
        <span>Manizales y Caldas</span>
        <span aria-hidden="true">·</span>
        <Coordinates class="font-normal tracking-normal normal-case" />
      </p>
      <h1 class="mt-4 max-w-4xl text-display">
        Mapa abierto del ecosistema tecnológico de Manizales y Caldas
      </h1>
      <p class="mt-5 max-w-reading text-lg leading-relaxed font-normal text-graphite">
        Un lugar para consultar, relacionar y verificar quién construye tecnología en la región.
        Datos abiertos, verificables y mantenidos por comunidad.
      </p>

      <div class="mt-8">
        <GlobalSearch />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="/ecosistema" class="btn-primary">Explorar el mapa del ecosistema</a>
        <a href="/contribuir" class="btn-secondary">Contribuir con datos</a>
      </div>
    </div>
  </section>

  <!-- Empieza por aquí: orientación por necesidad, justo debajo del buscador. -->
  <section class="container-content py-12" aria-labelledby="empieza">
    <h2 id="empieza" class="text-2xl">Empieza por aquí</h2>
    <p class="mt-1 max-w-reading text-graphite-2">
      ¿Qué te trae al mapa? Elige un punto de partida según lo que necesitas.
    </p>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {starts.map((s) => <li>
        <a href={s.href} class="ficha p-5 no-underline">
          <span class="font-display text-lg font-bold [font-stretch:108%]">
            <span class="ficha-title-link">{s.title}</span>
          </span>
          <span class="mt-1 block text-sm text-graphite-2">{s.text}</span>
          <span
            class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-ink-blue underline underline-offset-[3px]"
          >
            {s.cta} <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>)}
    </ul>
  </section>

  <!-- Qué es, para quién y qué se puede hacer: contexto después de la intención principal. -->
  <section class="container-content pb-12" aria-labelledby="sobre">
    <h2 id="sobre" class="sr-only">Sobre el observatorio</h2>
    <dl class="fields">
      <div class="field p-4">
        <dt>Qué es</dt>
        <dd class="mt-1 leading-relaxed font-normal">
          Un archivo público del ecosistema TIC de Manizales y Caldas: empresas, universidades,
          programas, personas, comunidades y eventos, cada registro con su fuente y su estado de
          verificación.
        </dd>
      </div>
      <div class="field p-4">
        <dt>Para quién</dt>
        <dd class="mt-1 leading-relaxed font-normal">
          Para quien estudia o quiere estudiar TIC, trabaja o emprende en tecnología, organiza
          comunidad o investiga el territorio.
        </dd>
      </div>
      <div class="field p-4">
        <dt>Qué puedes hacer</dt>
        <dd class="mt-1 leading-relaxed font-normal">
          Buscar y filtrar registros, revisar fichas con fuentes públicas, explorar cómo se conectan
          entre sí y aportar o corregir datos.
        </dd>
      </div>
    </dl>
  </section>

  <!-- Nota histórica 2020 → 2026 -->
  <section class="border-y border-rule bg-sheet-alt">
    <div
      class="container-content flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="max-w-2xl text-sm text-graphite">
        <span class="data text-xs text-graphite-2">{site.startedYear} → {site.currentYear}</span>
        &nbsp; Proyecto iniciado en {site.startedYear} como repositorio comunitario y ampliado en
        {site.currentYear}, verificando por partes con fuentes públicas. Cada ficha muestra su
        estado y su fecha de revisión; reconocemos lo que aún no está confirmado y lo convertimos en
        una invitación a contribuir.
      </p>
      <span class="flex shrink-0 flex-col gap-1 sm:items-end">
        <a href="/metodologia" class="link text-sm">Ver metodología →</a>
        <a href="/decadas" class="link text-sm">Evolución por décadas →</a>
      </span>
    </div>
  </section>

  <!-- El archivo: un solo índice con el conteo de cada tipo de registro. -->
  <section class="container-content py-12" aria-labelledby="archivo">
    <h2 id="archivo" class="text-2xl">Explora el archivo</h2>
    <p class="mt-1 max-w-reading text-graphite-2">
      Seis tipos de registro conforman el mapa. Cada uno se explora, filtra y verifica por separado.
    </p>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {archive.map((it) => <li>
        <a href={it.href} class="ficha p-5 no-underline">
          <span class="flex items-start justify-between gap-4">
            <span class="font-display text-lg font-bold [font-stretch:108%]">
              <span class="ficha-title-link">{it.title}</span>
            </span>
            <span class="figure text-[2.5rem] leading-none">{it.count}</span>
          </span>
          <span class="mt-2 block text-sm text-graphite-2">{it.text}</span>
        </a>
      </li>)}
    </ul>
    <p class="data mt-3 text-xs text-graphite-2">
      Cifras a corte de {cutoff}. Son registros del archivo, no indicadores de desempeño ni un
      ranking.
    </p>
  </section>

  <!-- Verificación: cada estado enlaza a los listados ya filtrados por ese estado. -->
  <section class="border-y border-rule bg-sheet-alt">
    <div class="container-content py-12" aria-labelledby="verificacion">
      <h2 id="verificacion" class="text-2xl">Cómo leemos la verificación</h2>
      <p class="mt-1 max-w-reading text-graphite-2">
        Cada registro tiene un grado de confianza. No ocultamos la incertidumbre: la mostramos y la
        convertimos en una invitación a aportar fuentes. Entra a un estado para ver qué registros lo
        tienen.
      </p>
      <ul
        class="mt-6 grid grid-cols-1 gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-5"
      >
        {byState.map(({ state, total, parts }) => <li class="flex flex-col gap-3 bg-sheet p-4">
          <span class={verificationMeta[state].badge}>
            <span aria-hidden="true">{verificationMeta[state].symbol}</span>
            {verificationMeta[state].label}
          </span>
          <p class="figure text-2xl">
            {total}
            <span class="data ml-1 text-xs font-normal text-graphite-2">de {distTotal}</span>
          </p>
          {parts.length > 0 ? (
            <ul class="grid gap-1 text-sm">
              {parts.map((part) => <li>
                <a
                  href={part.href}
                  class="link inline-flex min-h-6 items-baseline gap-1.5 font-normal"
                >
                  <span class="sr-only">{verificationMeta[state].label}:</span>
                  {part.label}
                  <span class="data text-xs">{part.count}</span>
                </a>
              </li>)}
            </ul>
          ) : (
            <p class="text-sm text-graphite-2">Sin registros en este estado.</p>
          )}
        </li>)}
      </ul>
    </div>
  </section>

  <!-- Muestra de personas -->
  <section class="container-content py-12" aria-labelledby="personas">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="personas" class="text-2xl">Personas que construyen ecosistema</h2>
      <a href="/personas" class="link shrink-0 text-sm">Ver todas →</a>
    </div>
    <p class="mt-1 max-w-reading text-graphite-2">
      Reconocimiento por trayectoria y contribuciones públicas, en orden alfabético. No es un
      ranking.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredPeople.map((p) => (
        <PersonCard person={p} />
      ))}
    </div>
  </section>

  <!-- CTA de contribución -->
  <section class="container-content pb-16">
    <ContributionCTA variant="general" />
  </section>
</Layout>
