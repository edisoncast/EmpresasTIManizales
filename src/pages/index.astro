---
import Layout from '../components/Layout.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import StatsGrid from '../components/StatsGrid.astro';
import ContributionCTA from '../components/ContributionCTA.astro';
import PersonCard from '../components/PersonCard.astro';
import { stats, companies, universities, programs, people, communities } from '../lib/data';
import { site } from '../lib/site';
import { formatDate } from '../lib/format';
import {
  resolveVerification,
  verificationMeta,
  verificationOrder,
  type VerificationState,
} from '../lib/verification';

const cutoff = formatDate(site.auditDate);
const activeCommunities = communities.filter((community) => community.status === 'active');

const metrics = [
  { label: 'Empresas', value: stats.companies, href: '/empresas' },
  { label: 'Universidades', value: stats.universities, href: '/universidades' },
  { label: 'Programas', value: stats.programs, href: '/programas' },
  { label: 'Comunidades activas', value: activeCommunities.length, href: '/comunidades' },
  { label: 'Personas', value: stats.people, href: '/personas' },
  { label: 'Agenda', value: stats.events, href: '/eventos' },
];

// Orientación por necesidad para quien llega por primera vez.
const starts = [
  {
    title: 'Quiero estudiar',
    text: 'Universidades y programas TIC de la región: técnico, tecnológico, pregrado y posgrado.',
    href: '/formacion',
    cta: 'Ver formación',
  },
  {
    title: 'Quiero conocer empresas',
    text: 'Empresas de base tecnológica y casas de desarrollo de software registradas en Caldas.',
    href: '/empresas',
    cta: 'Ver empresas',
  },
  {
    title: 'Quiero participar en comunidad',
    text: 'Comunidades, meetups y la agenda de encuentros técnicos de la región.',
    href: '/comunidades',
    cta: 'Ver comunidad',
  },
  {
    title: 'Quiero entender el territorio',
    text: 'Cómo se conectan universidades, empresas, personas y comunidades en el mapa.',
    href: '/ecosistema',
    cta: 'Ver el mapa',
  },
];

const index = [
  {
    href: '/empresas',
    title: 'Empresas',
    count: stats.companies,
    text: 'Empresas de base tecnológica y casas de desarrollo de software.',
  },
  {
    href: '/universidades',
    title: 'Universidades',
    count: stats.universities,
    text: 'Instituciones con formación en software, datos, redes y afines.',
  },
  {
    href: '/programas',
    title: 'Programas',
    count: stats.programs,
    text: 'Técnicos, tecnológicos, pregrados y posgrados del área TIC.',
  },
  {
    href: '/personas',
    title: 'Personas',
    count: stats.people,
    text: 'Trayectorias públicas que construyen ecosistema.',
  },
  {
    href: '/comunidades',
    title: 'Comunidades activas',
    count: activeCommunities.length,
    text: 'Meetups activos y archivo histórico de comunidades técnicas de la región.',
  },
  {
    href: '/eventos',
    title: 'Agenda',
    count: stats.events,
    text: 'Encuentros próximos, pasados y por verificar, dentro de Comunidad.',
  },
];

// Distribución de estados de verificación en todo el archivo.
const allEntities = [...companies, ...universities, ...programs, ...people, ...communities];
const dist: Record<VerificationState, number> = {
  verified: 0,
  partially_verified: 0,
  unknown: 0,
  inactive_or_unverified: 0,
  archived: 0,
};
for (const e of allEntities) dist[resolveVerification(e)]++;
const distTotal = allEntities.length;

const featuredPeople = people.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site ?? Astro.url).toString(),
};
---

<Layout jsonLd={jsonLd}>
  <!-- Hero: titular, casillas de propósito y buscador. Sin ilustraciones. -->
  <section class="border-b-2 border-graphite bg-fog">
    <div class="container-content py-14 sm:py-16 lg:py-20">
      <p class="field-label flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>Observatorio abierto</span>
        <span aria-hidden="true">·</span>
        <span>Manizales y Caldas</span>
        <span aria-hidden="true">·</span>
        <span class="data font-normal normal-case tracking-normal">5.07° N · 75.52° O</span>
      </p>
      <h1 class="mt-4 max-w-4xl text-display">
        Mapa abierto del ecosistema tecnológico de Manizales y Caldas
      </h1>
      <p class="mt-5 max-w-reading text-lg font-normal leading-relaxed text-graphite">
        Un lugar para consultar, relacionar y verificar quién construye tecnología en la región.
        Datos abiertos, verificables y mantenidos por comunidad.
      </p>

      <!-- Respuesta inmediata a: qué es, para quién es y qué se puede hacer. -->
      <dl class="fields mt-8 max-w-5xl">
        <div class="field p-4">
          <dt>Qué es</dt>
          <dd class="mt-1 font-normal leading-relaxed">
            Un archivo público del ecosistema TIC de Manizales y Caldas: empresas, universidades,
            programas, personas, comunidades y eventos, cada registro con su fuente y su estado de
            verificación.
          </dd>
        </div>
        <div class="field p-4">
          <dt>Para quién</dt>
          <dd class="mt-1 font-normal leading-relaxed">
            Para quien estudia o quiere estudiar TIC, trabaja o emprende en tecnología, organiza
            comunidad o investiga el territorio.
          </dd>
        </div>
        <div class="field p-4">
          <dt>Qué puedes hacer</dt>
          <dd class="mt-1 font-normal leading-relaxed">
            Buscar y filtrar registros, revisar fichas con fuentes públicas, explorar cómo se
            conectan entre sí y aportar o corregir datos.
          </dd>
        </div>
      </dl>

      <div class="mt-8 max-w-xl">
        <GlobalSearch />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="/ecosistema" class="btn-primary">Explorar el mapa del ecosistema</a>
        <a href="/contribuir" class="btn-secondary">Contribuir con datos</a>
      </div>
    </div>
  </section>

  <!-- Empieza por aquí: orientación por necesidad -->
  <section class="container-content py-14" aria-labelledby="empieza">
    <h2 id="empieza" class="text-2xl">Empieza por aquí</h2>
    <p class="mt-1 max-w-reading text-graphite-2">
      ¿Qué te trae al mapa? Elige un punto de partida según lo que necesitas.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        starts.map((s) => (
          <a href={s.href} class="ficha p-5 no-underline">
            <h3 class="text-lg">
              <span class="ficha-title-link">{s.title}</span>
            </h3>
            <p class="mt-1 text-sm text-graphite-2">{s.text}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-ink-blue underline underline-offset-[3px]">
              {s.cta} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Nota histórica 2020 → 2026 -->
  <section class="border-y border-rule bg-sheet-alt">
    <div
      class="container-content flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="max-w-2xl text-sm text-graphite">
        <span class="data text-xs text-graphite-2">{site.startedYear} → {site.currentYear}</span>
        &nbsp; Proyecto iniciado en {site.startedYear} como repositorio comunitario y ampliado en {
          site.currentYear
        }, verificando por partes con fuentes públicas. Cada ficha muestra su estado y su fecha de
        revisión; reconocemos lo que aún no está confirmado y lo convertimos en una invitación a
        contribuir.
      </p>
      <span class="flex shrink-0 flex-col gap-1 sm:items-end">
        <a href="/metodologia" class="link text-sm">Ver metodología →</a>
        <a href="/decadas" class="link text-sm">Evolución por décadas →</a>
      </span>
    </div>
  </section>

  <!-- Métricas del ecosistema -->
  <section class="container-content py-14" aria-labelledby="metricas">
    <h2 id="metricas" class="mb-6 text-2xl">El ecosistema en cifras</h2>
    <StatsGrid
      stats={metrics}
      caption={`Cifras a corte de ${cutoff}. Son registros del archivo, no indicadores de desempeño ni un ranking.`}
    />
  </section>

  <!-- Accesos principales: índice del archivo -->
  <section class="container-content py-6" aria-labelledby="explora">
    <h2 id="explora" class="text-2xl">Explora el archivo</h2>
    <p class="mt-1 max-w-reading text-graphite-2">
      Seis tipos de registro conforman el mapa. Cada uno se explora, filtra y verifica por separado.
    </p>
    <ul class="mt-6 divide-y divide-rule border-y-2 border-graphite">
      {
        index.map((it) => (
          <li>
            <a
              href={it.href}
              class="ficha flex-row items-baseline gap-4 border-0 py-4 no-underline"
            >
              <span class="flex-1">
                <span class="font-display text-lg font-bold text-graphite [font-stretch:108%]">
                  <span class="ficha-title-link">{it.title}</span>
                </span>
                <span class="data ml-2 text-xs text-graphite-2">{it.count}</span>
                <span class="mt-0.5 block max-w-xl text-sm text-graphite-2">{it.text}</span>
              </span>
              <span aria-hidden="true" class="text-graphite-2">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Verificación -->
  <section class="mt-8 border-y border-rule bg-sheet-alt">
    <div class="container-content py-14" aria-labelledby="verificacion">
      <h2 id="verificacion" class="text-2xl">Cómo leemos la verificación</h2>
      <p class="mt-1 max-w-reading text-graphite-2">
        Cada registro tiene un grado de confianza. No ocultamos la incertidumbre: la mostramos y la
        convertimos en una invitación a aportar fuentes.
      </p>
      <dl
        class="mt-6 grid grid-cols-1 gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-5"
      >
        {
          verificationOrder.map((s) => (
            <div class="bg-sheet p-4">
              <dt class="flex items-center gap-2">
                <span class={`${verificationMeta[s].badge}`}>
                  <span aria-hidden="true">{verificationMeta[s].symbol}</span>
                  {verificationMeta[s].label}
                </span>
              </dt>
              <dd class="figure mt-3 text-2xl">
                {dist[s]}
                <span class="data ml-1 text-xs font-normal text-graphite-2">de {distTotal}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Muestra de personas -->
  <section class="container-content py-14" aria-labelledby="personas">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="personas" class="text-2xl">Personas que construyen ecosistema</h2>
      <a href="/personas" class="link shrink-0 text-sm">Ver todas →</a>
    </div>
    <p class="mt-1 max-w-reading text-graphite-2">
      Reconocimiento por trayectoria y contribuciones públicas, en orden alfabético. No es un
      ranking.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredPeople.map((p) => <PersonCard person={p} />)}
    </div>
  </section>

  <!-- CTA de contribución -->
  <section class="container-content pb-16">
    <ContributionCTA variant="general" />
  </section>
</Layout>
